# Copy to terraform.tfvars and adjust. Never commit the real file — it is
# gitignored. AWS credentials come from the environment / AWS CLI profile,
# never from this file.

aws_region         = "ap-south-1"
project_name       = "medidesk"
environment        = "dev"
cluster_version    = "1.31"
node_instance_type = "t3.medium"
node_min_size      = 1
node_desired_size  = 2
node_max_size      = 3
